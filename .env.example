# Frontend API base URL. Leave empty when using the Vite proxy.
VITE_API_URL=

# Standalone backend settings
PORT=8787
HOST=127.0.0.1
GAMETRACKER_DB_PATH=./data/gametracker.db
# Comma-separated exact origins. Set this to your production website origin(s).
CORS_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false
TRUST_PROXY=false

# Protect public registration with Turnstile, or keep it private with an invite code.
# Turnstile site key is public; secret key and invite code must stay server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REGISTRATION_INVITE_CODE=
# In production, set true if NODE_ENV is not set to production. Signup fails closed if no protection is configured.
REGISTRATION_REQUIRE_PROTECTION=false
