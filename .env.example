# Frontend API base URL. Leave empty for local development (uses the Vite proxy).
# Set to the hosted backend URL for deployments that do not use a same-origin API.
VITE_API_URL=

# Standalone backend settings
PORT=8787
HOST=127.0.0.1
GAMETRACKER_DB_PATH=./data/gametracker.db
# Comma-separated exact origins. Set this to your production website origin(s).
CORS_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false
TRUST_PROXY=false

# Public registration is enabled and rate-limited by the backend.

# Password recovery mail (set these in the backend environment, never in frontend/VITE_* variables).
RESEND_API_KEY=re_KmeLTBhB_6TX6FgeZDe2wnHgpRpiZXkWEre_KmeLTBhB_6TX6FgeZDe2wnHgpRpiZXkWE
# Use a sender address/domain verified in Resend; set APP_URL to the deployed frontend origin in production.
RESEND_FROM=RESEND_FROM="GameTracker <onboarding@resend.dev>"
APP_URL=http://localhost:5173
